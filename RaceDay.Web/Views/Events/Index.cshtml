@model List<RaceDay.Contracts.EventDto>
@{
    ViewData["Title"] = "Events";
}

<h1 class="mb-2">Upcoming RaceDay Events</h1>
<p class="text-muted mb-4">Find your next run, walk or cycle event</p>

<div class="row">
    @if (Model != null && Model.Any())
    {
        @foreach (var item in Model)
        {
            <div class="col-md-6 col-lg-4 mb-4">
                <div class="card h-100">
                    <div class="card-body">
                        <h5 class="card-title">@item.EventName</h5>
                        <p class="card-text mb-1"><strong>Date:</strong> @item.EventDate.ToString("dd MMM yyyy")</p>
                        <p class="card-text mb-1"><strong>Location:</strong> @item.Location</p>
                        <p class="card-text mb-1"><strong>Type:</strong> @item.EventType</p>
                        <p class="card-text mb-3"><strong>Distance:</strong> @(item.DistanceKm?.ToString("0.00") ?? "N/A") km</p>
                        <a asp-action="Details" asp-route-id="@item.EventId" class="btn btn-primary btn-sm">View Details</a>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="col-12">
            <p class="text-muted">No events available at the moment.</p>
        </div>
    }
</div>
