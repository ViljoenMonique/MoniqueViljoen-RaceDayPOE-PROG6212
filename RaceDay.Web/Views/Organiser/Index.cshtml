@model List<RaceDay.Contracts.EventDto>
@{
    ViewData["Title"] = "Organiser Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0">Organiser Dashboard</h1>
    <a asp-controller="Events" asp-action="Create" class="btn btn-success">+ Create New Event</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>Event Name</th>
                        <th>Date</th>
                        <th>Location</th>
                        <th>Type</th>
                        <th>Distance</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model == null || !Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">You have not created any events yet.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-semibold">@item.EventName</td>
                                <td>@item.EventDate.ToString("dd MMM yyyy")</td>
                                <td>@item.Location</td>
                                <td>@item.EventType</td>
                                <td>@(item.DistanceKm?.ToString("0.00") ?? "-") km</td>
                                <td class="text-end">
                                    <a asp-controller="Events" asp-action="Details" asp-route-id="@item.EventId" class="btn btn-sm btn-outline-primary me-1">View</a>
                                    <a asp-controller="Events" asp-action="Edit" asp-route-id="@item.EventId" class="btn btn-sm btn-warning me-1">Edit</a>
                                    <a asp-controller="Categories" asp-action="Index" asp-route-eventId="@item.EventId" class="btn btn-sm btn-outline-info me-1">Categories</a>
                                    <a asp-controller="Enrolments" asp-action="EventEnrolments" asp-route-eventId="@item.EventId" class="btn btn-sm btn-outline-success me-1">Enrolments</a>
                                    <form asp-controller="Events" asp-action="Delete" asp-route-id="@item.EventId" method="post" class="d-inline"
                                          onsubmit="return confirm('Are you sure you want to delete this event?');">
                                        <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>