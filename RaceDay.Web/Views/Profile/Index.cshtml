@model RaceDay.Contracts.ProfileDto
@{
    ViewData["Title"] = "My Profile";
}

<div class="container mt-4">
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card text-center">
                <div class="card-body py-5">
                    @if (!string.IsNullOrEmpty(Model.ProfileImageUrl))
                    {
                        <img src="@Model.ProfileImageUrl" class="profile-image mb-3" alt="Profile" />
                    }
                    else
                    {
                        <div class="profile-image bg-secondary d-inline-flex align-items-center justify-content-center text-white mb-3">
                            <span class="fs-1">@Model.FirstName[0]</span>
                        </div>
                    }
                    <h3>@Model.FirstName @Model.LastName</h3>
                    <p class="text-muted mb-1">@Model.Email</p>
                    <p class="mb-3"><span class="badge bg-primary">@Model.Role</span></p>
                    <p class="text-muted">@(string.IsNullOrEmpty(Model.Phone) ? "Phone not set" : Model.Phone)</p>
                    <a asp-action="Edit" class="btn btn-outline-primary mt-3">Edit Profile</a>
                </div>
            </div>
        </div>
    </div>
</div>